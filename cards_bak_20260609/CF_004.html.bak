.recipe-box{padding:12px 14px;background:#efe6dc;border-radius:10px;font-size:13px;line-height:2;color:#3a322a;margin-bottom:6px}
.recipe-box strong{color:#C0392B}
.copy-box{padding:10px 14px;background:#f8f4ef;border-radius:8px;font-size:12px;color:#5a4f44;line-height:1.8;margin-top:6px}
